  "voice": {
    "tone": "Direct and competent. No filler. Assume the user knows their domain. Write for the person who has read the docs.",
    "prohibited_words": [
      "seamless",
      "powerful",
      "robust",
      "intuitive",
      "easy",
      "simple"
    ],
    "prohibited_patterns": [
      "Never-ending feature lists",
      "Hyperbolic adjective stacking",
      "Passive voice for user actions"
    ],
    "cta_style": "Action-verb + specific outcome. 'Connect your repository' not 'Get started'. 'View usage' not 'Learn more'.",
    "formatting": {
      "heading_case": "sentence case",
      "button_case": "sentence case",
      "label_case": "ALL CAPS, letter-spaced"
    },
    "terminology": {
      "workspace": "project",
      "users": "team members"
    }
  },
  "ux_writing": {
    "empty_states": {
      "pattern": "State what's missing + one concrete action. 'No deployments yet. Connect a repository to start deploying.' Never 'Nothing to see here.'",
      "source": "UX writing guidelines v1.2",
      "source_url": "",
      "last_verified": "2026-01-15"
    },
    "error_messages": {
      "pattern": "What happened + why + what to do next. Never blame the user.",
      "tone": "Calm and practical. No apology, no alarm.",
      "structure": "[What failed]. [Why, if known]. [Next step or contact link].",
      "source": "UX writing guidelines v1.2",
      "source_url": "",
      "last_verified": "2026-01-15"
    },
    "tooltips": {
      "pattern": "One short sentence — what the element does, not what it is. Skip 'This button...'",
      "max_length": "80 characters",
      "tone": "Terse and precise.",
      "avoid": [
        "obvious restatements of button labels",
        "marketing language"
      ],
      "source": "UX writing guidelines v1.2",
      "source_url": "",
      "last_verified": "2026-01-15"
    },
    "buttons_ctas": {
      "pattern": "Action-verb + specific outcome. Describe the result, not the navigation.",
      "verb_preference": "Action verbs: Deploy, Connect, Archive, Invite, Remove. Not: Click to, Go to, View.",
      "style": "Specific over generic. The CTA should describe the outcome, not the navigation.",
      "examples": [
        "Deploy to production",
        "Connect GitHub",
        "Invite team member"
      ],
      "source": "UX writing guidelines v1.2",
      "source_url": "",
      "last_verified": "2026-01-15"
    },
    "form_labels": {
      "pattern": "Sentence case. Helper text is format guidance only — the label names the field.",
      "case": "sentence case",
      "helper_text_style": "Format guidance only. Not instructions for what the field is for — the label handles that.",
      "placeholder_policy": "Use sparingly. Never as a substitute for a label. Format example preferred over instructional text.",
      "source": "UX writing guidelines v1.2",
      "source_url": "",
      "last_verified": "2026-01-15"
    },
    "notifications": {
      "pattern": "Success: past tense action confirmed. Error: what failed + next step. Warning: what might go wrong + what to do.",
      "success": "Confirm the action completed. Past tense. 'Deployment created.' Not 'Success!'",
      "error": "What failed + next step. 'Connection failed. Check your credentials and try again.'",
      "warning": "What might go wrong + what to do before it does.",
      "info": "Context only. Non-urgent. No action required unless explicitly stated.",
      "source": "UX writing guidelines v1.2",
      "source_url": "",
      "last_verified": "2026-01-15"
    },
    "loading_states": {
      "pattern": "Action in progress. 'Deploying...' not 'Loading...'. 'Scanning repository...' not 'Please wait.'",
      "examples": [
        "Deploying...",
        "Connecting to GitHub...",
        "Syncing team members..."
      ],
      "source": "UX writing guidelines v1.2",
      "source_url": "",
      "last_verified": "2026-01-15"
    },
    "onboarding": {
      "pattern": "One task per step. Encouraging but efficient. No sales copy in setup flows.",
      "tone": "Encouraging but efficient. Get the user to value fast. No sales copy in setup flows.",
      "structure": "One task per step. Clear progress indicator. Skip steps that don't apply.",
      "source": "UX writing guidelines v1.2",
      "source_url": "",
      "last_verified": "2026-01-15"
    },
