# ui-studio — .gitignore

# active-brand.json is the currently loaded client config.
# It is generated by ui-studio-onboard and is client-specific.
# Track named configs in brand-config/ (e.g., acme.json) instead.
# Remove this line if you are working with a single permanent brand config
# and want to track it in version control.
brand-config/active-brand.json

# Generated Cursor rules file — regenerated by cursor-export.py from active-brand.json.
# Do not track; re-generate after any brand config change.
.cursor/rules/ui-studio.mdc

# DTCG-native sibling configs — regenerable output of dtcg-codemod.py (W5 / audit G7).
# The codemod produces <name>.dtcg.json from a legacy scalar config; it is a build
# artifact, not a source of truth (committing it would recreate the very hand-synced
# drift surface W5 removes). The in-place DTCG migration of a config is the tracked
# change, decided per config by a human. Do not track codemod output.
brand-config/*.dtcg.json

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# OS noise
.DS_Store
Thumbs.db
